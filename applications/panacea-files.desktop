[Desktop Entry]
Type=Application
Version=1.0
Name=EverythingOS — Files
Name[ru]=EverythingOS — проводник
Comment=The file manager built into the shell
Comment[ru]=Проводник, встроенный в оболочку
Exec=qs -c @HOME@/.config/everythingos ipc call pill filesAt %f
Icon=@HOME@/.config/everythingos/assets/logo-128.png
Terminal=false
Categories=System;
MimeType=inode/directory;
