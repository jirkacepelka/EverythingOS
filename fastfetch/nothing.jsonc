{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/nothing-logo.txt",
        "padding": { "top": 2, "left": 1, "right": 6 },
        "color": { "1": "#ffffff", "2": "#363636" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "#737373", "title": "#ffffff", "separator": "#737373" },
        "key": { "type": "string", "width": 8 },
        "bar": { "border": { "left": "", "right": "" }, "char": { "elapsed": "●", "total": "·" }, "width": 12,
                 "color": { "elapsed": "#ffffff", "total": "#404040" } },
        "percent": { "type": 6, "width": 12 }
    },
    "modules": [
        { "type": "title", "color": { "user": "white", "at": "#737373", "host": "white" } },
        { "type": "custom", "format": "{#38;2;64;64;64}────────────────────────────" },
        { "type": "os",       "key": "OS" },
        { "type": "kernel",   "key": "KERNEL", "format": "{2}" },
        { "type": "uptime",   "key": "UPTIME" },
        { "type": "wm",       "key": "WM", "format": "{1}" },
        { "type": "shell",    "key": "SHELL", "format": "{6}" },
        { "type": "cpu",      "key": "CPU", "format": "{1}" },
        { "type": "memory",   "key": "MEMORY", "format": "{percentage-bar}  {used} / {total}" },
        { "type": "disk",     "key": "DISK", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total}" },
        { "type": "custom", "format": "{#38;2;64;64;64}────────────────────────────" },
        { "type": "custom", "key": " ", "format": "{#38;2;255;255;255}●  {#38;2;190;190;190}●  {#38;2;130;130;130}●  {#38;2;85;85;85}●  {#38;2;54;54;54}●" }
    ]
}
