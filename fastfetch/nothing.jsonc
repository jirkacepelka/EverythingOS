{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nothing-logo.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 4
    },
    "color": {
      "1": "#ffffff",
      "2": "#9a9a9a",
      "3": "#4a4a4a",
      "4": "#D71921"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#8a8a8a",
      "title": "#ffffff",
      "separator": "#3d3d3d"
    },
    "key": {
      "type": "string",
      "width": 18
    },
    "bar": {
      "border": {
        "left": "",
        "right": ""
      },
      "char": {
        "elapsed": "\u25cf",
        "total": "\u00b7"
      },
      "width": 12,
      "color": {
        "elapsed": "#ffffff",
        "total": "#3d3d3d"
      }
    },
    "percent": {
      "type": 6,
      "width": 12
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "white",
        "at": "#D71921",
        "host": "white"
      }
    },
    {
      "type": "break"
    },
    {
      "type": "os",
      "key": "\uf32a  OS",
      "format": "{name} {version-id}"
    },
    {
      "type": "kernel",
      "key": "\uf17c  KERNEL",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "\uf017  UPTIME"
    },
    {
      "type": "packages",
      "key": "\uf487  PACKAGES",
      "format": "{dpkg} dpkg \u00b7 {flatpak-user} flatpak"
    },
    {
      "type": "shell",
      "key": "\uf120  SHELL",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "\uf2d0  WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "\uf489  TERMINAL",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "\uf2db  CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "\uf0e4  GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\uf538  MEMORY",
      "format": "{percentage-bar}  {used} / {total}"
    },
    {
      "type": "disk",
      "key": "\uf0a0  DISK",
      "folders": "/",
      "format": "{size-percentage-bar}  {size-used} / {size-total}"
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": "{#38;2;215;25;33}\u25cf {#38;2;255;255;255}\u25cf {#38;2;190;190;190}\u25cf {#38;2;130;130;130}\u25cf {#38;2;85;85;85}\u25cf {#38;2;54;54;54}\u25cf",
      "key": " "
    }
  ]
}