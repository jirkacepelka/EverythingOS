{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ${XDG_CONFIG_HOME:-$HOME/.config}/everythingos/scripts/agent-approval.py Codex",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
